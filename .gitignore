# Never commit vendor or modified firmware.
*.bin
*.pkg
*.fw
*.ota
*.apk
*.apks
*.xapk
*.rpk
*.idsig

# Never commit credentials or signing material.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.pk8
*.key
secrets/

# Generated research output.
firmware/
captures/
output/
reports/private/
site/
*.log
*.tmp
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors and operating systems.
.idea/
.vscode/
.DS_Store
Thumbs.db
